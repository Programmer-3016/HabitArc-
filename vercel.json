{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/coach.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://habitarc-dfa40.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://habitarc-dfa40.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
