{
  "id": "/",
  "name": "HabitArc",
  "short_name": "HabitArc",
  "description": "HabitArc combines mindful habits, tasks, notes, focus sessions and an AI coach.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#f6f4ef",
  "theme_color": "#47e393",
  "categories": [
    "productivity",
    "health",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
