rules_version = '2';

// HabitArc keeps every account in its own Firestore path. These rules let a
// signed-in Firebase user access only their profile/settings document and the
// habit documents and their durable daily completion history nested beneath it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/habits/{habitId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/habitCompletions/{completionId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
    // Task manager: per-account documents, never shared between users.
    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == taskId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1500
        && request.resource.data.dueDate is string
        && request.resource.data.priority in ['none', 'low', 'medium', 'high']
        && request.resource.data.habitId is string
        && request.resource.data.noteId is string
        && request.resource.data.subtasks is list
        && request.resource.data.subtasks.size() <= 40
        && request.resource.data.completed is bool
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'description', 'dueDate', 'priority',
          'habitId', 'noteId', 'subtasks', 'completed', 'completedAt',
          'createdAt', 'updatedAt', '_updatedAt'
        ]);
    }
  }
}
