rules_version = '2';

// HabitArc keeps every account in its own Firestore path. These rules let a
// signed-in Firebase user access only their profile/settings document and the
// habit documents and their durable daily completion history nested beneath it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/habits/{habitId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/habitCompletions/{completionId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
    // Task manager: per-account documents, never shared between users.
    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == taskId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1500
        && request.resource.data.dueDate is string
        && request.resource.data.priority in ['none', 'low', 'medium', 'high']
        && request.resource.data.habitId is string
        && request.resource.data.noteId is string
        && request.resource.data.subtasks is list
        && request.resource.data.subtasks.size() <= 40
        && request.resource.data.completed is bool
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'description', 'dueDate', 'priority',
          'habitId', 'noteId', 'subtasks', 'completed', 'completedAt',
          'createdAt', 'updatedAt', '_updatedAt'
        ]);
    }
    // Notes contain private user text and Cloud Storage media flags only.
    match /users/{userId}/notes/{noteId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == noteId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 10000
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 10
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.pinned is bool
        && request.resource.data.deleted is bool
        && request.resource.data.hasPhoto is bool
        && request.resource.data.hasAudio is bool
        && request.resource.data.color in ['lavender', 'mint', 'peach', 'white']
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'body', 'date', 'createdAt', 'updatedAt',
          'pinned', 'color', 'deleted', 'hasPhoto', 'hasAudio', '_updatedAt'
        ]);
    }
    match /users/{userId}/focusSessions/{sessionId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == sessionId
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.minutes is number
        && request.resource.data.minutes >= 1
        && request.resource.data.minutes <= 180
        && request.resource.data.taskId is string
        && request.resource.data.completedAt is string
        && request.resource.data.keys().hasOnly([
          'id', 'date', 'minutes', 'taskId', 'completedAt', '_updatedAt'
        ]);
    }

    match /users/{userId}/pushDevices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Opt-in public League card: aggregate score & handle only, never private habit names.
    match /leagueMembers/{userId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.tone is int
        && request.resource.data.tone >= 0
        && request.resource.data.tone <= 7
        && request.resource.data.weekly is int
        && request.resource.data.weekly >= 0
        && request.resource.data.weekly <= 50000
        && request.resource.data.allTime is int
        && request.resource.data.allTime >= 0
        && request.resource.data.allTime <= 500000
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 3650
        && request.resource.data.clearDays is int
        && request.resource.data.clearDays >= 0
        && request.resource.data.clearDays <= 3650
        && request.resource.data.squadCode is string
        && request.resource.data.squadCode.size() <= 6
        && request.resource.data.updatedAt is string
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'tone', 'weekly', 'allTime', 'streak',
          'clearDays', 'squadCode', 'updatedAt', '_updatedAt'
        ]);
    }

    // 6-character Friends Squad invite rooms (max 30 members).
    match /leagueRooms/{roomCode} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && roomCode.matches('^[A-Z0-9]{6}$')
        && request.resource.data.code == roomCode
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 28
        && request.resource.data.createdBy is string
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 30
        && request.resource.data.updatedAt is string
        && request.resource.data.keys().hasOnly([
          'code', 'name', 'createdBy', 'memberUids', 'updatedAt', '_updatedAt'
        ]);
    }
  }
}
