rules_version = '2';

// HabitArc keeps every account in its own Firestore path. These rules let a
// signed-in Firebase user access only their profile/settings document and the
// habit documents nested beneath it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/habits/{habitId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
