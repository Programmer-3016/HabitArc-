# Server-only configuration for /api/coach. Never put these values in client JS
# or commit a filled-in .env file. Use a dedicated Google Cloud / AI Studio
# project key solely for HabitArc so quota and billing stay separated.
HABITARC_GEMINI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Optional alternative if pasting raw downloaded JSON directly:
# FIREBASE_SERVICE_ACCOUNT_JSON=
AI_COACH_DAILY_LIMIT=15
